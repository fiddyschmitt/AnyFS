<Project>
  <ItemGroup>
    <!-- runtime -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.13" />
    <PackageVersion Include="ZLogger" Version="2.5.10" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <!-- the SSHFS source (spec 7.2, 15) -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- the SharePoint sources (spec 7.3, 15): the Microsoft identity platform sign-in -->
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.91.0" />
    <!-- the E2E tests read provisioning/settings.yml -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- the SharePoint live tests keep a sign-in on disk, DPAPI-protected on Windows (tests/fixtures/SharePointSignIn) -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- mount providers (spec 8, 15) -->
    <!-- winfsp.net must stay on the major.minor of the driver scripts/winfsp.json bundles: its interop refuses any other
         driver version at load ("incorrect dll version"). The 2.2.x packages are the WinFsp 2026 betas; AnyFS.App checks
         the two agree at build. -->
    <PackageVersion Include="winfsp.net" Version="2.1.25156" />
    <PackageVersion Include="LTRData.FuseDotNet" Version="1.0.0.14" />
    <!-- the window (spec 11) -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- tests -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="MSTest" Version="4.5.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>

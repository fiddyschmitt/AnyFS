# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# AnyFS test lab: the Linux and Windows test machines, VirtualBox VMs bridged onto the LAN. (The
# macOS VM runs on the Mac mini and is driven from here by mac.ps1.) This file defines the MACHINES;
# ansible/playbook.yml (Linux) and windows/provision.ps1 (Windows) configure what runs INSIDE them.
# Tunables for all of it live in settings.yml.
#
#   vagrant up                      create, boot and (first time) provision every VM
#   vagrant up <name>               the same for one VM from settings.yml
#   vagrant provision [name]        re-apply the configuration (safe to repeat)
#   vagrant reload --provision [n]  apply a memory/cpus/ip change from settings.yml
#   vagrant ssh <name>              shell into a VM
#   vagrant halt | destroy [name]   stop | delete

require "fileutils"
require "json"
require "socket"
require "yaml"

settings = YAML.load_file(File.join(__dir__, "settings.yml"))
dev_box  = settings.fetch("dev_box")
folders  = dev_box.fetch("shared_folders")

# When the provisioning restarts a Windows VM, Vagrant waits 2 minutes for it by default; a first
# boot's rename and the autologon change can take longer.
ENV["VAGRANT_MAX_REBOOT_RETRY_DURATION"] ||= "900"

# The lab's SSH key: every machine accepts it. Made on first use.
lab_key = File.expand_path(settings.fetch("ssh_key"))
unless File.exist?(lab_key)
  FileUtils.mkdir_p(File.dirname(lab_key))
  system("ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "anyfs test lab", "-f", lab_key) or
    abort("Couldn't create the lab's SSH key #{lab_key}: is ssh-keygen on the PATH?")
end
lab_pubkey = File.read("#{lab_key}.pub").strip

# The shared folders must exist before VirtualBox can share them.
publish_dir = File.expand_path(folders.fetch("publish"), __dir__)
winfsp_dir  = File.expand_path(folders.fetch("winfsp"), __dir__)
FileUtils.mkdir_p(publish_dir)
FileUtils.mkdir_p(winfsp_dir)

# The WinFsp installer the Windows VM gets: the one scripts/winfsp.json pins (scripts/fetch-winfsp.ps1
# puts it under tools/winfsp); the provisioner checks the hash before installing it.
winfsp = JSON.parse(File.read(File.join(__dir__, "..", "scripts", "winfsp.json"))).fetch("winfsp")

# The SharePoint Server farm (machines with role dc and sharepoint): its domain, accounts and media
# (scripts/fetch-sharepoint.ps1 puts the installation images under tools/sharepoint).
sharepoint = settings.fetch("sharepoint")
sp_accounts = sharepoint.fetch("accounts")
sharepoint_media_dir = File.expand_path(sharepoint.fetch("media"), __dir__)
FileUtils.mkdir_p(sharepoint_media_dir)

# The Exchange Server (the machine with role exchange): its organisation, its mailboxes, its media (tools/exchange
# holds the ISO) and the PST fixtures it imports.
exchange = settings.fetch("exchange")
exchange_media_dir = File.expand_path(exchange.fetch("media"), __dir__)
exchange_pst_dir = File.expand_path(exchange.fetch("pst_fixtures"), __dir__)
FileUtils.mkdir_p(exchange_media_dir)

# The GitLab server (the machine with role gitlab): the domain controller makes its Kerberos service account and keytab.
gitlab = settings.fetch("gitlab")

# Each machine's smoke test runs after every `vagrant up`, `reload` and `provision` (after any
# restart the provisioning needed): its PASS/WARN/FAIL lines are shown, and a FAIL stops Vagrant there.
class LabSmokeTestFailed < Vagrant::Errors::VagrantError
  error_message("The smoke test failed: see its FAIL lines above.")
end

smoke_test = lambda do |machine, windows|
  output  = +""
  collect = proc { |_type, data| output << data }
  status  = if windows
              machine.communicate.execute('powershell -NoProfile -ExecutionPolicy Bypass -File C:\anyfs-lab\smoke-test.ps1',
                                          error_check: false, &collect)
            else
              machine.communicate.sudo("/opt/anyfs/smoke-test.sh", error_check: false, &collect)
            end
  output.each_line { |line| machine.ui.info(line.chomp) unless line.strip.empty? }
  raise LabSmokeTestFailed if status != 0
end

Vagrant.configure("2") do |config|
  upstream = settings.fetch("machines").find { |m| m.fetch("role") == "upstream" } or abort("settings.yml needs a machine with role upstream")
  linux_account = settings.fetch("accounts").fetch("linux")

  settings.fetch("machines").each do |m|
    name    = m.fetch("name")
    windows = m.fetch("os") == "windows"
    abort("#{name}: a Windows computer name has at most 15 characters") if windows && name.length > 15

    config.vm.define name, autostart: m["autostart"] != false do |node|
      node.vm.box         = m.fetch("box")
      node.vm.box_version = m["box_version"] if m["box_version"]
      node.vm.hostname    = name

      # NIC 2: bridged onto the LAN at the machine's own address. (NIC 1 stays NAT: Vagrant's own
      # connection uses it, and so does the guest's internet access, so the LAN NIC needs no gateway.)
      node.vm.network "public_network", bridge: settings.fetch("network").fetch("bridge_adapter"),
                                        ip: m.fetch("ip")

      node.vm.provider "virtualbox" do |vb|
        vb.name   = name
        vb.memory = m.fetch("memory_mb")
        vb.cpus   = m.fetch("cpus")
        # Each VM's disk holds only what differs from its box, which VirtualBox imports once.
        vb.linked_clone = true
        # Names resolve through this PC's resolver at the time of each query, so a VM keeps DNS when
        # the PC's servers change (a VPN, say).
        vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
      end

      if windows
        # The box's first boot (it's sysprepped), then the rename and its reboot.
        node.vm.boot_timeout = 1200

        # `vagrant ssh <name> -c ...` hands its command to PowerShell, the VM's SSH shell.
        node.ssh.shell = "powershell"

        node.vm.synced_folder ".", "/vagrant", disabled: true

        account = settings.fetch("accounts").fetch("windows")
        # The account Vagrant, the tests and `vagrant ssh` use: the box's own, unless the machine names
        # another (the domain controller: promotion deletes every local account but Administrator).
        login_user = m.fetch("login_user", account.fetch("user"))
        if login_user != account.fetch("user")
          node.winrm.username = login_user
          node.winrm.password = account.fetch("password")
          node.ssh.username = login_user
        end
        marker = 'C:\anyfs-lab\restart-required'

        case m.fetch("role")
        when "host"
          # \\vboxsvr\publish is provisioning/publish (the builds under test), \\vboxsvr\winfsp the pinned
          # installer, \\vboxsvr\runremote the RunRemote build the provisioner installs. Vagrant also links
          # each one at the path given here, which nothing uses.
          node.vm.synced_folder publish_dir, "C:/anyfs-lab/publish", id: "publish", SharedFoldersEnableSymlinksCreate: false
          node.vm.synced_folder winfsp_dir, "C:/anyfs-lab/winfsp", id: "winfsp", SharedFoldersEnableSymlinksCreate: false
          node.vm.synced_folder settings.fetch("windows").fetch("runremote_dir"), "C:/anyfs-lab/runremote",
                                id: "runremote", SharedFoldersEnableSymlinksCreate: false

          # the lab's domain, when it has one: its names (the GitLab server's, the KDC's) resolve through the domain
          # controller, so Kerberos works from here without joining the domain
          dc = settings.fetch("machines").find { |x| x.fetch("role") == "dc" }
          node.vm.provision "file", source: "windows/smoke-test.ps1", destination: "C:/anyfs-lab/smoke-test.ps1"
          node.vm.provision "shell", path: "windows/provision.ps1",
                                     env: { "LAB_PUBKEY" => lab_pubkey,
                                            "LAB_USER" => login_user,
                                            "LAB_PASSWORD" => account.fetch("password"),
                                            "UPSTREAM_IP" => upstream.fetch("ip"),
                                            "WINFSP_MSI" => winfsp.fetch("asset"),
                                            "WINFSP_SHA256" => winfsp.fetch("sha256"),
                                            "LAB_DOMAIN" => dc ? sharepoint.fetch("domain") : "",
                                            "DC_IP" => dc ? dc.fetch("ip") : "" }

          # The autologon change takes a restart to show: the provisioner leaves a marker when it changed
          # something that needs one. Then the smoke test.
          node.trigger.after [:up, :reload, :provision] do |t|
            t.name = "#{name}: restart if the provisioner asked for one, then the smoke test"
            t.ruby do |_env, machine|
              if machine.communicate.test("if (Test-Path '#{marker}') { exit 0 } else { exit 1 }")
                machine.communicate.execute("Remove-Item -Force '#{marker}'")
                machine.guest.capability(:reboot)
              end
              smoke_test.call(machine, true)
            end
          end

        when "dc", "sharepoint", "exchange"
          # The SharePoint farm's machines (provisioning/sharepoint/README.md) and the Exchange server. Their provisioners work in
          # rounds: each does what is missing, and leaves the marker when the next step needs a restart
          # (promotion to a domain controller, joining the domain, SQL Server, SharePoint's prerequisites).
          # The trigger restarts the VM and runs the provisioners again until no restart is asked for, then
          # runs the smoke test. The nested provisioning runs fire this trigger too; those skip it.
          sp_env = { "LAB_PUBKEY" => lab_pubkey,
                     "LAB_USER" => login_user,
                     "LAB_PASSWORD" => account.fetch("password"),
                     "SP_DOMAIN" => sharepoint.fetch("domain"),
                     "SP_NETBIOS" => sharepoint.fetch("netbios"),
                     "SP_SETUP_USER" => sp_accounts.fetch("setup").fetch("user"),
                     "SP_SETUP_PASSWORD" => sp_accounts.fetch("setup").fetch("password"),
                     "SP_FARM_USER" => sp_accounts.fetch("farm").fetch("user"),
                     "SP_FARM_PASSWORD" => sp_accounts.fetch("farm").fetch("password"),
                     "SP_TEST_USER" => sp_accounts.fetch("tester").fetch("user"),
                     "SP_TEST_PASSWORD" => sp_accounts.fetch("tester").fetch("password") }
          if m.fetch("role") == "dc"
            sp_servers = settings.fetch("machines").select { |x| %w[sharepoint exchange gitlab].include?(x.fetch("role")) }
            abort("#{name}: a dc needs a machine with role sharepoint, exchange or gitlab in settings.yml") if sp_servers.empty?
            # the GitLab server's Kerberos service account, its principal HTTP/<host> and the keytab GitLab fetches (none without a gitlab machine)
            gitlab_env = if sp_servers.any? { |x| x.fetch("role") == "gitlab" }
                           { "GITLAB_HOST" => gitlab.fetch("host"),
                             "GITLAB_SERVICE_USER" => gitlab.fetch("service_account").fetch("user"),
                             "GITLAB_SERVICE_PASSWORD" => gitlab.fetch("service_account").fetch("password") }
                         else
                           {}
                         end
            # Short WinRM waits: its provisioner is quick, and a refused logon (see above) should surface in minutes.
            node.winrm.timeout = 300
            node.winrm.retry_limit = 2
            node.winrm.retry_delay = 5
            node.vm.provision "file", source: "windows/dc-smoke-test.ps1", destination: "C:/anyfs-lab/smoke-test.ps1"
            node.vm.provision "shell", path: "windows/dc-provision.ps1",
                                       env: sp_env.merge("SP_SAFE_MODE_PASSWORD" => sharepoint.fetch("safe_mode_password"),
                                                         # name=ip;name=ip: an A record for each server in the domain
                                                         "SP_SERVERS" => sp_servers.map { |x| "#{x.fetch("name")}=#{x.fetch("ip")}" }.join(";"))
                                                 .merge(gitlab_env)
          elsif m.fetch("role") == "sharepoint"
            dc = settings.fetch("machines").find { |x| x.fetch("role") == "dc" } or
              abort("#{name}: a sharepoint machine needs a machine with role dc in settings.yml")
            # the SQL Server this farm uses: another machine's (by its address, which needs no domain DNS), or its own
            sql_server = m["sql_server"]
            sql_server_ip = if sql_server
                              other = settings.fetch("machines").find { |x| x.fetch("name") == sql_server } or
                                abort("#{name}: sql_server #{sql_server} is not a machine in settings.yml")
                              other.fetch("ip")
                            else
                              ""
                            end
            # \\vboxsvr\sharepoint is tools/sharepoint, the installation images (SQL Server and SharePoint).
            node.vm.synced_folder sharepoint_media_dir, "C:/anyfs-lab/media", id: "sharepoint", SharedFoldersEnableSymlinksCreate: false
            # A round can take most of an hour, but no single WinRM call does (the elevated provisioner streams);
            # ten minutes bounds how long a call to a machine that is going down can hang.
            node.winrm.timeout = 600
            node.vm.provision "file", source: "windows/sp-smoke-test.ps1", destination: "C:/anyfs-lab/smoke-test.ps1"
            node.vm.provision "file", source: "windows/sp-farm-configuration.ps1", destination: "C:/anyfs-lab/sp-farm-configuration.ps1"
            node.vm.provision "file", source: "windows/sp-test-user.ps1", destination: "C:/anyfs-lab/sp-test-user.ps1"
            node.vm.provision "shell", path: "windows/sp-provision.ps1",
                                       env: sp_env.merge("DC_IP" => dc.fetch("ip"),
                                                         "SP_LAN_IP" => m.fetch("ip"),
                                                         "SP_PASSPHRASE" => sharepoint.fetch("passphrase"),
                                                         "SP_PRODUCT" => m.fetch("product").to_s,
                                                         "SP_IMAGE" => m.fetch("image"),
                                                         "SP_PRODUCT_KEY" => m.fetch("product_key"),
                                                         "SP_WEB_URL" => m.fetch("web_url"),
                                                         "SP_DB_PREFIX" => m.fetch("db_prefix"),
                                                         "SP_SQL_SERVER" => sql_server_ip,
                                                         "SP_SITE" => sharepoint.fetch("site"),
                                                         "SP_DSC_VERSION" => sharepoint.fetch("dsc_version"))
          else
            dc = settings.fetch("machines").find { |x| x.fetch("role") == "dc" } or
              abort("#{name}: an exchange machine needs a machine with role dc in settings.yml")
            # \\vboxsvr\exchange is tools/exchange, the installation image; \\vboxsvr\pst the PST fixtures the tester's
            # mailbox is seeded from.
            node.vm.synced_folder exchange_media_dir, "C:/anyfs-lab/media", id: "exchange", SharedFoldersEnableSymlinksCreate: false
            node.vm.synced_folder exchange_pst_dir, "C:/anyfs-lab/pst", id: "pst", SharedFoldersEnableSymlinksCreate: false
            node.winrm.timeout = 600
            node.vm.provision "file", source: "windows/ex-smoke-test.ps1", destination: "C:/anyfs-lab/smoke-test.ps1"
            node.vm.provision "file", source: "windows/ex-configure.ps1", destination: "C:/anyfs-lab/ex-configure.ps1"
            node.vm.provision "shell", path: "windows/ex-provision.ps1",
                                       env: sp_env.merge("DC_IP" => dc.fetch("ip"),
                                                         "EX_LAN_IP" => m.fetch("ip"),
                                                         # the domain's Administrator: setup needs a schema, enterprise and domain administrator
                                                         "EX_ADMIN_USER" => dc.fetch("login_user", account.fetch("user")),
                                                         "EX_ADMIN_PASSWORD" => account.fetch("password"),
                                                         "EX_ORGANIZATION" => exchange.fetch("organization"),
                                                         "EX_IMAGE" => m.fetch("image"),
                                                         "EX_MAILBOXES" => exchange.fetch("mailboxes").values.map { |a| "#{a.fetch("user")}=#{a.fetch("password")}" }.join(";"),
                                                         "EX_TESTER" => exchange.fetch("mailboxes").fetch("tester").fetch("user"),
                                                         "EX_SHARED" => exchange.fetch("shared_mailbox"))
          end

          # The provisioner restarts the machine itself (shutdown /r, ten seconds after it exits) and leaves the
          # marker holding the boot time it is leaving; the next round removes a marker from an earlier boot. So
          # the trigger only waits until the machine answers with a different boot time (watching for it to go
          # down first does not work: a quick restart hides inside one WinRM call, 18-Oct-2026). Nothing is sent
          # over WinRM until port 5985 connects: a server that has just become a domain controller refuses WinRM
          # logons until it has restarted, and a call sent while it goes down hangs for the whole WinRM timeout.
          node.trigger.after [:up, :reload, :provision] do |t|
            t.name = "#{name}: the restarts the provisioner asks for, then the smoke test"
            t.ruby do |_env, machine|
              next if ENV["ANYFS_LAB_REPROVISIONING"] == name
              restarted = "if ((Test-Path '#{marker}') -and ((Get-Content '#{marker}' -Raw).Trim() -ne (Get-CimInstance Win32_OperatingSystem).LastBootUpTime.ToString('o'))) { exit 0 } else { exit 1 }"
              port_open = lambda do
                Socket.tcp(m.fetch("ip"), 5985, connect_timeout: 3) { true }
              rescue StandardError
                false
              end
              back = lambda do
                port_open.call && machine.communicate.test(restarted)
              rescue StandardError
                false
              end
              8.times do |round|
                asked = begin
                  machine.communicate.test("if (Test-Path '#{marker}') { exit 0 } else { exit 1 }")
                rescue StandardError => e
                  machine.ui.info("WinRM is not answering (#{e.class}): taking that as the restart the provisioner announced")
                  true
                end
                break unless asked
                machine.ui.info("Restart #{round + 1}: waiting for the machine to come back from it, then provisioning again")
                deadline = Time.now + 1500
                until back.call
                  raise "#{name}: the machine did not come back within 25 minutes of the restart the provisioner asked for" if Time.now > deadline
                  sleep 10
                end
                ENV["ANYFS_LAB_REPROVISIONING"] = name
                begin
                  machine.action(:provision)
                ensure
                  ENV.delete("ANYFS_LAB_REPROVISIONING")
                end
              end
              smoke_test.call(machine, true)
            end
          end

        else
          abort("#{name}: a Windows machine's role is host, dc, sharepoint or exchange, not #{m.fetch("role")}")
        end
      else
        # The project folder, so the guest can see ansible/ and settings.yml. The guests never need to
        # create symlinks in a shared folder, so they can't.
        node.vm.synced_folder ".", "/vagrant", SharedFoldersEnableSymlinksCreate: false
        node.vm.synced_folder publish_dir, "/media/vboxsf/#{dev_box.fetch("ip")}/publish", id: "publish",
                              SharedFoldersEnableSymlinksCreate: false

        # ansible_local: Vagrant installs Ansible INSIDE the guest and runs the playbook there (Ansible
        # can't be a control node on Windows). The machine's own entry from settings.yml is handed to the
        # play as `machine`; a GitLab server also gets the domain controller's (its LDAP, its KDC, its keytab share).
        dc = settings.fetch("machines").find { |x| x.fetch("role") == "dc" }
        abort("#{name}: a gitlab machine needs a machine with role dc in settings.yml") if m.fetch("role") == "gitlab" && dc.nil?
        node.vm.provision "ansible_local" do |ansible|
          ansible.playbook   = "ansible/playbook.yml"
          ansible.extra_vars = { machine: m, lab_pubkey: lab_pubkey, dc: dc ? { name: dc.fetch("name"), ip: dc.fetch("ip") } : nil }
        end

        # The play brings Debian up to date, the kernel included, and names the kernel the VM should
        # run: this boots it. Then the smoke test.
        node.trigger.after [:up, :reload, :provision] do |t|
          t.name = "#{name}: boot the newest kernel, then the smoke test"
          t.ruby do |_env, machine|
            other_kernel = '[ -f /etc/anyfs-lab-kernel ] && [ "$(uname -r)" != "$(cat /etc/anyfs-lab-kernel)" ]'
            machine.guest.capability(:reboot) if machine.communicate.test(other_kernel)
            smoke_test.call(machine, false)
          end
        end
      end
    end
  end
end

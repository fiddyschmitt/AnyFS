# Written by the AnyFS lab's playbook: what the GitLab seed and the smoke test read (KEY=value, unquoted, as
# `docker exec --env-file` takes it). root's only.
GITLAB_HOST={{ gitlab.host }}
GITLAB_IP={{ machine.ip }}
REALM={{ sharepoint.domain | upper }}
ROOT_PASSWORD={{ gitlab.root_password }}
ROOT_TOKEN={{ gitlab.root_token }}
TESTER_USER={{ sharepoint.accounts.tester.user }}
TESTER_PASSWORD={{ sharepoint.accounts.tester.password }}
TESTER_TOKEN={{ gitlab.tester_token }}
MAKETREE=/media/vboxsf/{{ dev_box.ip }}/publish/linux-x64/MakeTree

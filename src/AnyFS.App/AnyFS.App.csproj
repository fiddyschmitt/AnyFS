<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window when the GUI starts from Explorer; with arguments the process attaches
         to the console it was started from (spec 12, Program.cs). On Linux and macOS this is just an exe. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>anyfs</AssemblyName>
    <RootNamespace>AnyFS.App</RootNamespace>
    <IsPackable>false</IsPackable>
    <RollForward>LatestMinor</RollForward>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- compiled bindings everywhere: no reflection binding paths, so trimming can't break a binding (spec 11, 14.1) -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- plugin POCOs are deserialised by reflection; keep that path alive under trimming (spec 6.7, 14.1) -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- the settings form writes an empty box as null only for properties declared nullable (string?); the
         annotations and NullabilityInfoContext must survive trimming for that to hold for the built-ins -->
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <!-- the publish shape (spec 14): self-contained single file, trimmed; scripts/publish.ps1 passes the RID -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed Condition="'$(RuntimeIdentifier)' != '' and '$(NoTrim)' != 'true'">true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Our own trim problems are caught at build time (every library is IsTrimmable, warnings are errors).
         At publish, rooting System.Private.CoreLib and keeping reflection-based JSON alive for plugin
         POCOs makes ILLink report two framework-internal IL2026s (C++/CLI loader, ASP.NET's JsonOptions
         default resolver) and the ClassInterface/ProgId IL2045s that spike 7 saw; they are expected. -->
    <NoWarn>$(NoWarn);IL2026;IL2045</NoWarn>
    <!-- AVLN3001: views are constructed in code with their view models, never by the runtime XAML loader -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <!-- Bundled tools (spec 8.1, 8.2, 14). Every build embeds them for the runtime it targets: the publish RID, or the
       SDK's own RID for a plain build, so a Debug run from the IDE has them too. They live here rather than in the
       mount projects because the SDK builds library references without the RuntimeIdentifier.
       - portable-smb-server: scripts/fetch-go-servers.ps1 puts one per RID under tools/go-servers/; the SMB provider
         extracts it on first use.
       - the WinFsp installer: scripts/fetch-winfsp.ps1 puts the pinned MSI under tools/winfsp/; Windows builds embed
         it so the Install button installs the driver silently (winget is the fallback when a build has none). -->
  <PropertyGroup>
    <BundleRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</BundleRid>
    <BundleRid Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</BundleRid>
    <BundleIsWindows Condition="$(BundleRid.StartsWith('win'))">true</BundleIsWindows>
    <GoServersDir>$(MSBuildThisFileDirectory)..\..\tools\go-servers</GoServersDir>
    <SmbServerExt Condition="'$(BundleIsWindows)' == 'true'">.exe</SmbServerExt>
    <SmbServerBinary>$(GoServersDir)\$(BundleRid)\portable-smb-server$(SmbServerExt)</SmbServerBinary>
    <WinFspMsiDir>$(MSBuildThisFileDirectory)..\..\tools\winfsp</WinFspMsiDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(SmbServerBinary)')">
    <EmbeddedResource Include="$(SmbServerBinary)" LogicalName="portable-smb-server" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundleIsWindows)' == 'true'">
    <WinFspMsi Include="$(WinFspMsiDir)\winfsp-*.msi" />
    <EmbeddedResource Include="@(WinFspMsi)" LogicalName="winfsp.msi" />
  </ItemGroup>
  <Target Name="ReportBundledTools" BeforeTargets="CoreCompile">
    <Message Importance="high" Text="SMB: embedding $(SmbServerBinary)" Condition="Exists('$(SmbServerBinary)')" />
    <Message Importance="high" Text="SMB: no server binary at $(SmbServerBinary); run scripts/fetch-go-servers.ps1 first or the SMB provider will be unavailable in this build" Condition="!Exists('$(SmbServerBinary)')" />
    <Message Importance="high" Text="WinFsp: embedding @(WinFspMsi)" Condition="'@(WinFspMsi)' != ''" />
    <Message Importance="high" Text="WinFsp: no installer under $(WinFspMsiDir); run scripts/fetch-winfsp.ps1 first or the Install button will fall back to winget" Condition="'$(BundleIsWindows)' == 'true' and '@(WinFspMsi)' == ''" />
    <Error Text="WinFsp: more than one installer under $(WinFspMsiDir) (@(WinFspMsi)); keep the one scripts/winfsp.json pins" Condition="'@(WinFspMsi->Count())' &gt; '1'" />
    <!-- The .NET layer (winfsp.net) and the bundled driver must share a major.minor: Fsp.Interop.Api.CheckVersion refuses
         a driver of another major or an older minor at load ("incorrect dll version"), so a package bump without the
         installer (or the other way round) trips this on purpose. -->
    <PropertyGroup>
      <_WinFspPackageVersion>@(PackageVersion->WithMetadataValue('Identity', 'winfsp.net')->'%(Version)')</_WinFspPackageVersion>
      <_WinFspMsiVersion>@(WinFspMsi->'%(Filename)'->Replace('winfsp-', ''))</_WinFspMsiVersion>
      <_WinFspPackageMajorMinor Condition="$(_WinFspPackageVersion.Contains('.'))">$(_WinFspPackageVersion.Substring(0, $(_WinFspPackageVersion.LastIndexOf('.'))))</_WinFspPackageMajorMinor>
      <_WinFspMsiMajorMinor Condition="$(_WinFspMsiVersion.Contains('.'))">$(_WinFspMsiVersion.Substring(0, $(_WinFspMsiVersion.LastIndexOf('.'))))</_WinFspMsiMajorMinor>
    </PropertyGroup>
    <Message Importance="high" Text="WinFsp: .NET layer winfsp.net $(_WinFspPackageVersion), bundled driver $(_WinFspMsiVersion)" Condition="'$(_WinFspMsiVersion)' != ''" />
    <Error Text="WinFsp: winfsp.net $(_WinFspPackageVersion) (Directory.Packages.props) and the bundled driver $(_WinFspMsiVersion) (scripts/winfsp.json) must share a major.minor, or the .NET layer refuses the driver it installs. Pin the package back, or bump scripts/winfsp.json and run scripts/fetch-winfsp.ps1." Condition="'$(_WinFspPackageMajorMinor)' != '' and '$(_WinFspMsiMajorMinor)' != '' and '$(_WinFspPackageMajorMinor)' != '$(_WinFspMsiMajorMinor)'" />
  </Target>

  <!-- winfsp-msil (WinFsp's .NET layer) must load from a real file: its version check reads Assembly.Location, which is
       empty inside a single-file bundle. ILLink still sees it (rooted whole below), so what it needs is kept; the bundle
       then leaves it out and AnyFS.Mounts.WinFsp hands the runtime its own copy (WinFspInterop). It leaves the deps file's
       inputs too, the way ILLink drops the assemblies it removes, or the host would refuse to start without it. -->
  <Target Name="KeepWinFspInteropOutOfBundle" AfterTargets="ILLink" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_WinFspInterop Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'winfsp-msil.dll'" />
      <ResolvedFileToPublish Remove="@(_WinFspInterop)" />
      <_WinFspInteropDepsInput Include="@(ResolvedCompileFileDefinitions);@(RuntimeCopyLocalItems);@(RuntimeTargetsCopyLocalItems);@(UserRuntimeAssembly);@(RuntimePackAsset)" Condition="'%(Filename)%(Extension)' == 'winfsp-msil.dll'" />
      <ResolvedCompileFileDefinitions Remove="@(_WinFspInteropDepsInput)" />
      <RuntimeCopyLocalItems Remove="@(_WinFspInteropDepsInput)" />
      <RuntimeTargetsCopyLocalItems Remove="@(_WinFspInteropDepsInput)" />
      <UserRuntimeAssembly Remove="@(_WinFspInteropDepsInput)" />
      <RuntimePackAsset Remove="@(_WinFspInteropDepsInput)" />
    </ItemGroup>
    <Message Importance="high" Text="WinFsp: winfsp-msil kept out of the single-file bundle (@(_WinFspInterop->Count()) file); AnyFS.Mounts.WinFsp supplies it at run time" />
  </Target>

  <!-- The guaranteed set (spec 14.1): kept whole so third-party plugins can rely on it. Spike 7 showed that
       without System.Runtime no plugin DLL loads at all. Changing this list needs a clean obj/ (incremental ILLink). -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="AnyFS.Sdk" />
    <TrimmerRootAssembly Include="System.Private.CoreLib" />
    <TrimmerRootAssembly Include="System.Runtime" />
    <TrimmerRootAssembly Include="System.Collections" />
    <TrimmerRootAssembly Include="System.Collections.Concurrent" />
    <TrimmerRootAssembly Include="System.Linq" />
    <TrimmerRootAssembly Include="System.Memory" />
    <TrimmerRootAssembly Include="System.Threading" />
    <TrimmerRootAssembly Include="System.Threading.Tasks" />
    <TrimmerRootAssembly Include="System.IO.Compression" />
    <TrimmerRootAssembly Include="System.IO.Pipelines" />
    <TrimmerRootAssembly Include="System.Net.Http" />
    <TrimmerRootAssembly Include="System.Net.Primitives" />
    <TrimmerRootAssembly Include="System.Text.Json" />
    <TrimmerRootAssembly Include="System.Text.RegularExpressions" />
    <TrimmerRootAssembly Include="System.Security.Cryptography" />
    <TrimmerRootAssembly Include="System.Diagnostics.Process" />
    <TrimmerRootAssembly Include="System.ComponentModel.Primitives" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Mount-provider libraries kept whole (spec 14.1): winfsp.net, because the prefix-only mount reaches its internals
       by reflection. (The FTP server is our own code now; the library that needed rooting is gone.) ReverseMarkdown,
       which finds its tag converters by scanning its own assembly: the SharePoint source's pages as Markdown. -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="winfsp-msil" />
    <TrimmerRootAssembly Include="ReverseMarkdown" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnyFS.Sdk\AnyFS.Sdk.csproj" />
    <ProjectReference Include="..\AnyFS.Core\AnyFS.Core.csproj" />
    <ProjectReference Include="..\Sources\Mirror\AnyFS.Sources.Mirror.csproj" />
    <ProjectReference Include="..\Sources\SharePoint\AnyFS.Sources.SharePoint.csproj" />
    <ProjectReference Include="..\Sources\Sshfs\AnyFS.Sources.Sshfs.csproj" />
    <ProjectReference Include="..\Sources\ThreeDX\AnyFS.Sources.ThreeDX.csproj" />
    <ProjectReference Include="..\Mounts\Http\AnyFS.Mounts.Http.csproj" />
    <ProjectReference Include="..\Mounts\WebDav\AnyFS.Mounts.WebDav.csproj" />
    <ProjectReference Include="..\Mounts\Ftp\AnyFS.Mounts.Ftp.csproj" />
    <ProjectReference Include="..\Mounts\Smb\AnyFS.Mounts.Smb.csproj" />
    <ProjectReference Include="..\Mounts\WinFsp\AnyFS.Mounts.WinFsp.csproj" />
    <ProjectReference Include="..\Mounts\Fuse\AnyFS.Mounts.Fuse.csproj" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- F12 developer tools in Debug builds only; nothing of it ships -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AnyFS.App.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <!-- NTLM to SharePoint Server (and any Windows-authenticated upstream) from Linux: .NET's GSSAPI path needs the
         gss-ntlmssp plugin, which the lab's Debian host lacks, so .NET's own NTLM is switched on (for macOS builds
         too, untested there so far). It is a trimmer feature switch (System.Net.Security.UseManagedNtlm) that the
         ILLink targets default to false for linux RIDs through this private property, so this is the one place it
         can be set; Windows uses SSPI and ignores it (18-Oct-2026: the E2E SharePoint rows on Linux got a 401 until
         this). -->
    <_UseManagedNtlm>true</_UseManagedNtlm>
  </PropertyGroup>
</Project>

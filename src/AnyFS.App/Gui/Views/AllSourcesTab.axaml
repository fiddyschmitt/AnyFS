<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AnyFS.App.Gui.ViewModels"
             x:Class="AnyFS.App.Gui.Views.AllSourcesTab"
             x:DataType="vm:AllSourcesViewModel">
  <!-- spec 11.2: every source, with the collections using it; Import/Export arrive in milestone 4 -->
  <DockPanel Margin="4">
    <TextBlock DockPanel.Dock="Top" Classes="header" Text="All sources" />
    <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8" Text="A source is defined once and can sit in any number of collections, each with its own path and read-only flag. Enabled here applies everywhere." />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Classes="buttons" Margin="0,8,0,0">
      <Button Command="{Binding AddSourceCommand}" AutomationProperties.Name="Add source">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Classes="small" Data="{StaticResource IconAdd}" />
          <TextBlock Text="Add" />
        </StackPanel>
      </Button>
      <Button Command="{Binding EditSourceCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Classes="small" Data="{StaticResource IconEdit}" />
          <TextBlock Text="Edit" />
        </StackPanel>
      </Button>
      <Button Command="{Binding DeleteSourceCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Classes="small" Data="{StaticResource IconDelete}" />
          <TextBlock Text="Delete" />
        </StackPanel>
      </Button>
    </StackPanel>
    <!-- the tiles take up to 560 px and shrink with the window; the second column only soaks up the rest so they stay left -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="560" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Classes="muted" Text="No sources yet. Add one here, or from a collection's Sources list." IsVisible="{Binding IsEmpty}" Margin="0,8,0,0" />
      <ListBox Classes="tiles" Name="AllSourcesList" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" ItemTemplate="{StaticResource SourceTile}" SelectionMode="Single" />
    </Grid>
  </DockPanel>
</UserControl>

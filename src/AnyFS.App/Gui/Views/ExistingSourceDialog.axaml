<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnyFS.App.Gui.ViewModels"
        x:Class="AnyFS.App.Gui.Views.ExistingSourceDialog"
        x:DataType="vm:ExistingSourceDialogViewModel"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock Classes="caption" Text="Path" />
    <TextBox Name="PathBox" Text="{Binding Path}" PlaceholderText="(collection root)" />
    <TextBlock Classes="hint" Text="Where the source appears in this collection, '/'-separated. Empty means the source is the collection's root." />
    <CheckBox IsChecked="{Binding ReadOnly}" Content="Read-only in this collection" Margin="0,8,0,0" />
    <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Content="OK" IsDefault="True" Click="Ok_Click" IsEnabled="{Binding !Busy}" MinWidth="80" />
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>

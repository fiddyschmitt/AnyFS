<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnyFS.App.Gui.ViewModels"
        xmlns:views="using:AnyFS.App.Gui.Views"
        xmlns:g="using:AnyFS.App.Gui"
        x:Class="AnyFS.App.Gui.Views.MountDialog"
        x:DataType="vm:MountDialogViewModel"
        Title="{Binding Title}"
        Width="720" SizeToContent="Height" MaxHeight="820" CanResize="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- spec 11.1: provider list (unavailable ones greyed with the reason), name, the provider's settings form -->
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="OK" IsDefault="True" Click="Ok_Click" IsEnabled="{Binding !Busy}" MinWidth="80" />
        <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="80" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid ColumnDefinitions="260,16,*">
        <DockPanel Grid.Column="0" IsVisible="{Binding IsNew}">
          <TextBlock DockPanel.Dock="Top" Classes="caption" Text="Mount provider" />
          <TextBox DockPanel.Dock="Top" Text="{Binding Filter}" PlaceholderText="Filter providers" Margin="0,0,0,6" AutomationProperties.Name="Filter providers" />
          <!-- pill filters: kernel file systems and shares; nothing to install as an administrator -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
            <ToggleButton Classes="pill" Content="High performance" IsChecked="{Binding HighPerformanceOnly}" ToolTip.Tip="Kernel file systems and shares: WinFsp, FUSE, SMB" />
            <ToggleButton Classes="pill" Content="No admin" IsChecked="{Binding NoAdminOnly}" ToolTip.Tip="Hide providers that need an administrator to install something first" />
          </StackPanel>
          <ListBox ItemsSource="{Binding VisibleProviders}" SelectedItem="{Binding SelectedProvider}" MinHeight="200">
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" x:DataType="vm:ProviderChoiceViewModel">
                <Setter Property="IsEnabled" Value="{Binding OnThisOs}" />
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProviderChoiceViewModel">
                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                  <Border Classes="badge" Classes.icon="{Binding IconKey, Converter={x:Static g:Converters.HasPluginIcon}}" Width="26" Height="26" Margin="0,0,8,0">
                    <Panel>
                      <TextBlock Text="{Binding Initial}" />
                      <Image Source="{Binding IconKey, Converter={x:Static g:Converters.PluginIcon}}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" Text="{Binding Caption}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <StackPanel Grid.Column="0" IsVisible="{Binding !IsNew}">
          <TextBlock Classes="caption" Text="Mount provider" />
          <TextBlock Text="{Binding SelectedProvider.DisplayName, FallbackValue=''}" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{Binding SelectedProvider.Description, FallbackValue=''}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" IsVisible="{Binding ProviderUnavailable}">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Classes="small" Data="{StaticResource IconWarning}" />
                <TextBlock Text="{Binding ProviderUnavailableReason}" TextWrapping="Wrap" MaxWidth="380" />
              </StackPanel>
              <!-- N6: install it from here (WinFsp through winget), then the mount can be created and started -->
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanInstall}">
                <Button Content="{Binding SelectedProvider.InstallText, FallbackValue=''}" Command="{Binding InstallCommand}" ToolTip.Tip="{Binding SelectedProvider.InstallDetail, FallbackValue=''}" />
                <TextBlock Classes="muted" Text="{Binding InstallProgress}" IsVisible="{Binding Installing}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="300" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="caption" Text="Name *" />
          <TextBox Name="NameBox" Text="{Binding Name}" />
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
            <CheckBox IsChecked="{Binding Enabled}" Content="Enabled" />
            <CheckBox IsChecked="{Binding ReadOnly}" IsEnabled="{Binding !ReadOnlyLocked}" Content="Read-only" ToolTip.Tip="Everything through this mount is read-only, whatever the sources and collection allow" />
          </StackPanel>
          <Separator Margin="0,12,0,10" />
          <TextBlock Classes="subheader" Text="Settings" />
          <Panel IsVisible="{Binding HasForm}">
            <views:SettingsFormView DataContext="{Binding Form}" />
          </Panel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AnyFS.App.Gui.ViewModels"
             x:Class="AnyFS.App.Gui.Views.OpenButton"
             x:DataType="vm:TileViewModel">
  <!-- Open containing folder (spec 11.1): one mount opens it; several show a flyout; none is disabled; no tooltip (the user, 23-Oct-2026).
       Its words trim where a tile has not room for them beside the file count (a grid, as a StackPanel would give them all the room they ask for). -->
  <Panel>
    <Button Command="{Binding OpenSingleCommand}" IsVisible="{Binding HasOneOpenTarget}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
        <PathIcon Classes="small" Data="{StaticResource IconFolderOpen}" />
        <TextBlock Grid.Column="1" Text="Open containing folder" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Button>
    <Button IsVisible="{Binding HasManyOpenTargets}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
        <PathIcon Classes="small" Data="{StaticResource IconFolderOpen}" />
        <TextBlock Grid.Column="1" Text="Open containing folder" TextTrimming="CharacterEllipsis" />
        <PathIcon Grid.Column="2" Width="10" Height="10" Data="{StaticResource IconChevronDown}" />
      </Grid>
      <Button.Flyout>
        <MenuFlyout ItemsSource="{Binding OpenTargets}">
          <MenuFlyout.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:OpenTargetViewModel">
              <Setter Property="Header" Value="{Binding Header}" />
              <Setter Property="Command" Value="{Binding OpenCommand}" />
            </ControlTheme>
          </MenuFlyout.ItemContainerTheme>
        </MenuFlyout>
      </Button.Flyout>
    </Button>
    <Button IsEnabled="False" IsVisible="{Binding HasNoOpenTarget}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
        <PathIcon Classes="small" Data="{StaticResource IconFolderOpen}" />
        <TextBlock Grid.Column="1" Text="Open containing folder" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Button>
  </Panel>
</UserControl>

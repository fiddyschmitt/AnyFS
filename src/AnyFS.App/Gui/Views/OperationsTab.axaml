<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AnyFS.App.Gui.ViewModels"
             xmlns:g="using:AnyFS.App.Gui"
             x:Class="AnyFS.App.Gui.Views.OperationsTab"
             x:DataType="vm:OperationsTabViewModel">
  <!-- spec 11.5: what AnyFS and the source servers are being asked, as it happens; a finished operation stays five seconds, green or red -->
  <UserControl.Styles>
    <!-- a column header is a flat button: click to sort by it -->
    <Style Selector="Button.colhead">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.colhead.num">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.oprow">
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="Margin" Value="8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.cell.num">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <!-- a long path keeps its end, the file's name, and loses its middle; a server's address keeps its start, what was asked, and loses the end of its query -->
    <Style Selector="TextBlock.cell.path">
      <Setter Property="TextTrimming" Value="PrefixCharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.cell.path.address">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="4">
    <DockPanel DockPanel.Dock="Top">
      <TextBlock DockPanel.Dock="Left" Classes="header" Text="Operations" />
      <TextBlock Classes="muted" Text="{Binding Summary}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" FontFeatures="+tnum" />
    </DockPanel>
    <WrapPanel DockPanel.Dock="Top" ItemSpacing="16" LineSpacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Asked of" VerticalAlignment="Center" />
        <RadioButton Name="AskedOfAnyFS" GroupName="OperationsAskedOf" Content="AnyFS" IsChecked="{Binding AskedOfAnyFS}" ToolTip.Tip="What programs, and AnyFS itself, asked of a source through AnyFS: many are answered from what AnyFS keeps" />
        <RadioButton Name="AskedOfSource" GroupName="OperationsAskedOf" Content="Source" IsChecked="{Binding AskedOfSource}" ToolTip.Tip="What each source really asked of what is behind it: its server's requests, a mirrored folder's listings and metadata, a mail file's folders and items" />
        <RadioButton Name="AskedOfEither" GroupName="OperationsAskedOf" Content="Either" IsChecked="{Binding AskedOfEither}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Operations longer than" VerticalAlignment="Center" />
        <TextBox Name="LongerThan" Width="64" Text="{Binding LongerThanText}" PlaceholderText="0" />
        <TextBlock Text="seconds" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox Content="Failures only" IsChecked="{Binding FailuresOnly}" />
        <ToggleButton Content="Pause" IsChecked="{Binding IsPaused}" ToolTip.Tip="Hold the list still; operations go on being recorded" />
        <Button Command="{Binding CopyCommand}" ToolTip.Tip="Copy the rows shown, tab-separated">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="small" Data="{StaticResource IconCopy}" />
            <TextBlock Text="Copy" />
          </StackPanel>
        </Button>
      </StackPanel>
    </WrapPanel>

    <!-- the source filter: a checkbox per source instance -->
    <Border DockPanel.Dock="Right" Classes="group" Width="210" Margin="8,0,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="subheader" Text="Sources" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Classes="buttons" Margin="0,0,0,8">
          <Button Content="All" Command="{Binding ShowAllSourcesCommand}" />
          <Button Content="None" Command="{Binding ShowNoSourcesCommand}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Classes="muted" Text="No sources yet." IsVisible="{Binding !HasSources}" />
        <ScrollViewer>
          <ItemsControl Name="SourceFilters" ItemsSource="{Binding Sources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SourceFilterViewModel">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" MinHeight="0" Padding="6,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- the list: a header of sort buttons, then the rows, virtualised -->
    <Border Classes="table">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="tablehead">
          <Grid ColumnDefinitions="96,84,120,110,6*,104,96,2*">
            <Button Classes="colhead" Content="{Binding StartedHeader}" Command="{Binding SortCommand}" CommandParameter="Started" />
            <Button Grid.Column="1" Classes="colhead" Content="{Binding AskedOfHeader}" Command="{Binding SortCommand}" CommandParameter="AskedOf" />
            <Button Grid.Column="2" Classes="colhead" Content="{Binding SourceHeader}" Command="{Binding SortCommand}" CommandParameter="Source" />
            <Button Grid.Column="3" Classes="colhead" Content="{Binding OperationHeader}" Command="{Binding SortCommand}" CommandParameter="Operation" />
            <Button Grid.Column="4" Classes="colhead" Content="{Binding PathHeader}" Command="{Binding SortCommand}" CommandParameter="Path" />
            <Button Grid.Column="5" Classes="colhead num" Content="{Binding DurationHeader}" Command="{Binding SortCommand}" CommandParameter="Duration" />
            <Button Grid.Column="6" Classes="colhead" Content="{Binding DetailHeader}" Command="{Binding SortCommand}" CommandParameter="Detail" />
            <Button Grid.Column="7" Classes="colhead" Content="{Binding ResultHeader}" Command="{Binding SortCommand}" CommandParameter="Result" />
          </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding EmptyText}" Margin="8,8" IsVisible="{Binding !HasRows}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Name="OperationRows" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OperationRowViewModel">
                <Border Classes="oprow" Background="{Binding Outcome, Converter={x:Static g:Converters.OutcomeBrush}}">
                  <Grid ColumnDefinitions="96,84,120,110,6*,104,96,2*">
                    <TextBlock Classes="cell" Text="{Binding Started}" ToolTip.Tip="{Binding StartedFull}" FontFeatures="+tnum" />
                    <TextBlock Grid.Column="1" Classes="cell" Text="{Binding AskedOf}" />
                    <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Source}" ToolTip.Tip="{Binding Source}" />
                    <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Operation}" ToolTip.Tip="{Binding Operation}" />
                    <TextBlock Grid.Column="4" Classes="cell path" Classes.address="{Binding IsAddress}" Text="{Binding PathShown}" ToolTip.Tip="{Binding Path}" />
                    <TextBlock Grid.Column="5" Classes="cell num" Text="{Binding Duration}" />
                    <TextBlock Grid.Column="6" Classes="cell" Text="{Binding Detail}" ToolTip.Tip="{Binding Detail}" />
                    <TextBlock Grid.Column="7" Classes="cell" Text="{Binding Result}" ToolTip.Tip="{Binding Result}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>

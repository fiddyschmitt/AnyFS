<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnyFS.App.Gui.ViewModels"
        x:Class="AnyFS.App.Gui.Views.PromptDialog"
        x:DataType="vm:PromptDialogViewModel"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- a plugin's question (spec 6.4, 11.4): with the source's name, one at a time -->
  <StackPanel Margin="16">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <PathIcon Width="16" Height="16" Data="{StaticResource IconKey}" />
      <TextBlock Classes="muted" Text="{Binding SourceName}" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" Margin="0,6,0,0" />

    <TextBox Name="TextBox" Text="{Binding Text}" IsVisible="{Binding IsText}" Margin="0,12,0,0" />
    <TextBox Name="PasswordBox" Text="{Binding Text}" IsVisible="{Binding IsPassword}" PasswordChar="●" RevealPassword="{Binding Reveal}" Margin="0,12,0,0">
      <TextBox.InnerRightContent>
        <ToggleButton IsChecked="{Binding Reveal}" Background="Transparent" BorderThickness="0" Padding="6" ToolTip.Tip="Show">
          <PathIcon Classes="small" Data="{StaticResource IconEye}" />
        </ToggleButton>
      </TextBox.InnerRightContent>
    </TextBox>
    <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" IsVisible="{Binding IsChoice}" Margin="0,12,0,0" MaxHeight="240" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Content="Yes" IsDefault="True" Click="Yes_Click" IsVisible="{Binding IsYesNo}" MinWidth="80" />
      <Button Content="No" Click="No_Click" IsVisible="{Binding IsYesNo}" MinWidth="80" />
      <Button Content="OK" IsDefault="True" Click="Ok_Click" IsVisible="{Binding HasOkCancel}" MinWidth="80" />
      <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="80" />
    </StackPanel>
  </StackPanel>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AnyFS.App.Gui.ViewModels"
             xmlns:views="using:AnyFS.App.Gui.Views"
             x:Class="AnyFS.App.Gui.Views.SettingsFormView"
             x:DataType="vm:SettingsFormViewModel">
  <!-- The form generated from [Setting] attributes (spec 6.7): one template per kind, picked by FieldTemplateSelector -->
  <UserControl.Resources>
    <views:FieldTemplateSelector x:Key="FieldTemplates">
      <DataTemplate x:Key="Text" x:DataType="vm:SettingFieldViewModel">
        <StackPanel Margin="0,0,0,10" IsVisible="{Binding IsVisible}">
          <TextBlock Classes="caption" Text="{Binding LabelWithMark}" />
          <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" />
          <views:FieldFooter />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Multiline" x:DataType="vm:SettingFieldViewModel">
        <StackPanel Margin="0,0,0,10" IsVisible="{Binding IsVisible}">
          <TextBlock Classes="caption" Text="{Binding LabelWithMark}" />
          <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="96" MaxHeight="220" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
          <views:FieldFooter />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Password" x:DataType="vm:SettingFieldViewModel">
        <StackPanel Margin="0,0,0,10" IsVisible="{Binding IsVisible}">
          <TextBlock Classes="caption" Text="{Binding LabelWithMark}" />
          <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" PasswordChar="●" RevealPassword="{Binding Reveal}">
            <TextBox.InnerRightContent>
              <ToggleButton IsChecked="{Binding Reveal}" Background="Transparent" BorderThickness="0" Padding="6" ToolTip.Tip="Show">
                <PathIcon Classes="small" Data="{StaticResource IconEye}" />
              </ToggleButton>
            </TextBox.InnerRightContent>
          </TextBox>
          <views:FieldFooter />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Number" x:DataType="vm:SettingFieldViewModel">
        <StackPanel Margin="0,0,0,10" IsVisible="{Binding IsVisible}">
          <TextBlock Classes="caption" Text="{Binding LabelWithMark}" />
          <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" MaxWidth="200" HorizontalAlignment="Left" MinWidth="120" />
          <views:FieldFooter />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Bool" x:DataType="vm:SettingFieldViewModel">
        <StackPanel Margin="0,0,0,10" IsVisible="{Binding IsVisible}">
          <CheckBox IsChecked="{Binding Checked}" Content="{Binding Label}" />
          <views:FieldFooter />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Choice" x:DataType="vm:SettingFieldViewModel">
        <StackPanel Margin="0,0,0,10" IsVisible="{Binding IsVisible}">
          <TextBlock Classes="caption" Text="{Binding LabelWithMark}" />
          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" MinWidth="220" HorizontalAlignment="Left" />
          <views:FieldFooter />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Path" x:DataType="vm:SettingFieldViewModel">
        <StackPanel Margin="0,0,0,10" IsVisible="{Binding IsVisible}">
          <TextBlock Classes="caption" Text="{Binding LabelWithMark}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" />
            <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
          </Grid>
          <views:FieldFooter />
        </StackPanel>
      </DataTemplate>
    </views:FieldTemplateSelector>
  </UserControl.Resources>

  <StackPanel>
    <ItemsControl ItemsSource="{Binding Groups}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SettingGroupViewModel">
          <StackPanel IsVisible="{Binding IsVisible}">
            <TextBlock Classes="group" Text="{Binding Name}" IsVisible="{Binding HasName}" />
            <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldTemplates}" IsVisible="{Binding !IsAdvanced}" />
            <Expander Header="Advanced" IsVisible="{Binding IsAdvanced}" IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,4,0,8">
              <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldTemplates}" Margin="0,8,0,0" />
            </Expander>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Classes="error" Text="{Binding FormError}" IsVisible="{Binding FormError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasTest}" Margin="0,4,0,0">
      <Button Content="Test" Command="{Binding TestCommand}" />
      <ProgressBar IsIndeterminate="True" Width="60" Height="4" MinWidth="60" IsVisible="{Binding TestRunning}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding TestMessage}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
    </StackPanel>
  </StackPanel>
</UserControl>

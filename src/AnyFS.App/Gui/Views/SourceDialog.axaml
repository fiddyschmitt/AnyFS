<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnyFS.App.Gui.ViewModels"
        xmlns:views="using:AnyFS.App.Gui.Views"
        xmlns:g="using:AnyFS.App.Gui"
        x:Class="AnyFS.App.Gui.Views.SourceDialog"
        x:DataType="vm:SourceDialogViewModel"
        Title="{Binding Title}"
        Width="720" SizeToContent="Height" MaxHeight="820" CanResize="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- spec 11.1: (1) pick the plugin, (2) the setting that says what the source is (when the plugin marks one), name,
       path, read-only, then the rest of the plugin's settings form -->
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="OK" IsDefault="True" Click="Ok_Click" IsEnabled="{Binding !Busy}" MinWidth="80" />
        <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="80" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid ColumnDefinitions="240,16,*">
        <!-- (1) the plugin -->
        <DockPanel Grid.Column="0" IsVisible="{Binding IsNew}">
          <TextBlock DockPanel.Dock="Top" Classes="caption" Text="Source type" />
          <!-- with hundreds of source types the list needs a filter: name, description or type id -->
          <TextBox DockPanel.Dock="Top" Text="{Binding Filter}" PlaceholderText="Filter source types" Margin="0,0,0,6" AutomationProperties.Name="Filter source types" />
          <ListBox ItemsSource="{Binding VisiblePlugins}" SelectedItem="{Binding SelectedPlugin}" MinHeight="200">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PluginChoiceViewModel">
                <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                  <Border Classes="badge" Classes.icon="{Binding IconKey, Converter={x:Static g:Converters.HasPluginIcon}}" Width="26" Height="26" Margin="0,0,8,0">
                    <Panel>
                      <TextBlock Text="{Binding Initial}" />
                      <Image Source="{Binding IconKey, Converter={x:Static g:Converters.PluginIcon}}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <StackPanel Grid.Column="0" IsVisible="{Binding !IsNew}">
          <TextBlock Classes="caption" Text="Source type" />
          <TextBlock Text="{Binding SelectedPlugin.DisplayName, FallbackValue=''}" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{Binding SelectedPlugin.Description, FallbackValue=''}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- (2) the primary setting (a site's address), name, path, flags, the rest of the form -->
        <StackPanel Grid.Column="2">
          <ContentControl Name="PrimaryField" Content="{Binding Form.PrimaryField, FallbackValue={x:Null}}" ContentTemplate="{StaticResource FieldTemplates}"
                          IsVisible="{Binding Form.PrimaryField, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
          <TextBlock Classes="caption" Text="Name *" />
          <TextBox Name="NameBox" Text="{Binding Name}" />
          <TextBlock Classes="hint" Text="{Binding NameHint}" />

          <StackPanel IsVisible="{Binding AskPath}" Margin="0,10,0,0">
            <TextBlock Classes="caption" Text="Virtual Path" />
            <TextBox Text="{Binding Path}" PlaceholderText="(collection root)" />
            <TextBlock Classes="hint" Text="{x:Static vm:SourceDialogViewModel.PathCaption}" />
          </StackPanel>

          <!-- one panel, no margins between, so the three checkboxes are evenly spaced -->
          <StackPanel Margin="0,8,0,0">
            <CheckBox IsChecked="{Binding ReadOnly}" IsEnabled="{Binding !ReadOnlyLocked}" IsVisible="{Binding AskPath}" Content="Read-only in this collection" />
            <CheckBox IsChecked="{Binding Enabled}" Content="Enabled" />
            <CheckBox IsChecked="{Binding CountFilesOnStart}" Content="Count files on start" ToolTip.Tip="Walk the whole tree in the background after the source starts, so the file count is exact" />
          </StackPanel>

          <Separator Margin="0,12,0,10" />
          <TextBlock Classes="subheader" Text="Settings" />
          <Panel IsVisible="{Binding HasForm}">
            <views:SettingsFormView DataContext="{Binding Form}" />
          </Panel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>

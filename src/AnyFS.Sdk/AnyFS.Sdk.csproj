<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AnyFS.Sdk</AssemblyName>
    <RootNamespace>AnyFS.Sdk</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- the NuGet package (spec 6.1): a plugin project is `dotnet new classlib` + this reference + one class -->
    <IsPackable>true</IsPackable>
    <PackageId>AnyFS.Sdk</PackageId>
    <Title>AnyFS plugin SDK</Title>
    <Description>Plugin SDK for AnyFS, which presents anything as a file system: write a source (anything presented as files) or a mount provider, with declarative settings, prompts and caching helpers.</Description>
    <PackageTags>anyfs;filesystem;plugin;sdk;vfs;mount;fuse;winfsp;smb;webdav</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/fiddyschmitt/AnyFS</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>

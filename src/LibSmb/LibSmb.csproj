<Project Sdk="Microsoft.NET.Sdk">
  <!-- LibSmb: an SMB 2/3 file server in plain C#, from Microsoft's open specification [MS-SMB2], ported from
       portable-smb-server (Go): dialects 2.0.2 to 3.0.2, NTLMv2 through SPNEGO or guests, signing, compounding, Apple's
       extensions for macOS. It serves any ISmbFileSystem; LocalFileSystem serves a folder. Nothing of AnyFS's, and no
       dependency but Microsoft's logging abstractions: meant to stand on its own as a NuGet package one day. -->
  <PropertyGroup>
    <AssemblyName>LibSmb</AssemblyName>
    <RootNamespace>LibSmb</RootNamespace>
    <PackageId>LibSmb</PackageId>
    <Description>An SMB 2/3 file server in pure C# (dialects 2.0.2 to 3.0.2, NTLMv2 or guest, signing, compounding, Apple's macOS extensions) that serves shares from any file system you implement, or a local folder. No admin rights: listen on any port.</Description>
    <PackageTags>smb;smb2;smb3;cifs;file-server;file-sharing;ntlm</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LibSmb.Tests" />
    <!-- AnyFS's SMB mount tests use LibSmb.Tests' client (linked), which reads the wire with these internals -->
    <InternalsVisibleTo Include="AnyFS.Mounts.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AnyFS.Sources.Atlassian</AssemblyName>
    <RootNamespace>AnyFS.Sources.Atlassian</RootNamespace>
  </PropertyGroup>
  <!-- The Jira and Confluence sources (spec 7.10): two types over what they share here, the address and server discovery,
       the three sign-ins, the REST client, names and the HTML-to-Markdown step. Jira's REST API (/rest/api/2) and
       Confluence's (/rest/api) over HttpClient and System.Text.Json directly, no SDK. Data Center first. -->
  <ItemGroup>
    <ProjectReference Include="..\..\AnyFS.Sdk\AnyFS.Sdk.csproj" />
    <!-- the request pace, the web session (with its Selenium WebDriver fallback), the cookie jar, ResponseStream, MemoryFile, StateFile -->
    <ProjectReference Include="..\Common\AnyFS.Sources.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ReverseMarkdown (MIT) over AngleSharp (MIT): Jira's rendered text and Confluence's storage format as Markdown, as
         the SharePoint pages, Outlook bodies and Teams messages -->
    <PackageReference Include="ReverseMarkdown" />
    <PackageReference Include="AngleSharp" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="AnyFS.Sources.Common" />
  </ItemGroup>
  <ItemGroup>
    <!-- the types' icons (OpenIcon): own marks in each product's blue, drawn for AnyFS (Atlassian's logos are trademarks) -->
    <EmbeddedResource Include="Assets\jira.png" LogicalName="jira.png" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AnyFS.Sources.Tests" />
  </ItemGroup>
</Project>

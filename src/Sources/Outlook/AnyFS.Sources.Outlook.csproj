<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Outlook / Exchange source (spec 7.7): a mailbox as folders, a folder per message with the message as Markdown
       and as .eml and its attachments beside it, contacts as .vcf, appointments as .ics. Outlook's data files (PST, OST)
       through LibOutlook; a mailbox on Exchange Online through Outlook on the web's session or an app sign-in (Microsoft
       Graph), one on an Exchange server through EWS; all over the same IMailStore. -->
  <PropertyGroup>
    <AssemblyName>AnyFS.Sources.Outlook</AssemblyName>
    <RootNamespace>AnyFS.Sources.Outlook</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- ReverseMarkdown (MIT): a message's HTML body as Markdown, as the SharePoint source converts its pages -->
    <PackageReference Include="ReverseMarkdown" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AnyFS.Sdk\AnyFS.Sdk.csproj" />
    <ProjectReference Include="..\..\LibOutlook\LibOutlook.csproj" />
    <!-- the web session, Windows account credentials, MemoryFile -->
    <ProjectReference Include="..\Common\AnyFS.Sources.Common.csproj" />
    <!-- the Microsoft clouds, and for Exchange Online's app sign-in MSAL and Microsoft Graph's calls, as SharePoint's -->
    <ProjectReference Include="..\Microsoft365\AnyFS.Sources.Microsoft365.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="AnyFS.Sources.Common" />
    <Using Include="AnyFS.Sources.Microsoft365" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AnyFS.Sources.Tests" />
    <InternalsVisibleTo Include="SharePointSignIn" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AnyFS.Sources.SharePoint</AssemblyName>
    <RootNamespace>AnyFS.Sources.SharePoint</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- MSAL (MIT): the Microsoft identity platform sign-in for SharePoint Online and Embedded; trim-clean (spike 9).
         Microsoft Graph and SharePoint's REST API are spoken with HttpClient and System.Text.Json directly: the
         handful of calls a file system needs is not worth the Graph SDK's size under the trimmed single-file publish. -->
    <PackageReference Include="Microsoft.Identity.Client" />
    <!-- Selenium (Apache-2.0): the web session's fallback where AnyFS cannot reach the browser's DevTools port itself
         (a policy, or a profile the browser will not take). Selenium Manager, a native helper in the package, finds or
         downloads the driver that matches the browser; the single-file publish carries it (spec 7.3.2). -->
    <PackageReference Include="Selenium.WebDriver" />
    <!-- ReverseMarkdown (MIT) over AngleSharp (MIT): a site's pages show as Markdown (SharePointPages). MarkItDown's
         .NET ports carry cloud SDKs and image libraries for other formats; HTML is all a page is. -->
    <PackageReference Include="ReverseMarkdown" />
    <PackageReference Include="AngleSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AnyFS.Sdk\AnyFS.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AnyFS.Sources.Tests" />
    <InternalsVisibleTo Include="SharePointSignIn" />
  </ItemGroup>
</Project>

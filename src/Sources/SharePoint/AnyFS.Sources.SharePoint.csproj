<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AnyFS.Sources.SharePoint</AssemblyName>
    <RootNamespace>AnyFS.Sources.SharePoint</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- ReverseMarkdown (MIT) over AngleSharp (MIT): a site's pages show as Markdown (SharePointPages). MarkItDown's
         .NET ports carry cloud SDKs and image libraries for other formats; HTML is all a page is. -->
    <PackageReference Include="ReverseMarkdown" />
    <PackageReference Include="AngleSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AnyFS.Sdk\AnyFS.Sdk.csproj" />
    <!-- the web session (with its Selenium WebDriver fallback), Windows account credentials, ResponseStream, MemoryFile -->
    <ProjectReference Include="..\Common\AnyFS.Sources.Common.csproj" />
    <!-- the Microsoft clouds, the app sign-in (MSAL) and Microsoft Graph's calls, which Outlook shares; SharePoint's REST
         API is spoken with HttpClient and System.Text.Json directly, as Graph is -->
    <ProjectReference Include="..\Microsoft365\AnyFS.Sources.Microsoft365.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="AnyFS.Sources.Common" />
    <Using Include="AnyFS.Sources.Microsoft365" />
  </ItemGroup>
  <ItemGroup>
    <!-- the type's icon (OpenIcon): sharepoint.svg (the user's, 23-Oct-2026) rendered at 64 px, since the window draws
         PNG icons only (no SVG renderer for Avalonia 12 yet); render it again from the SVG when that changes -->
    <EmbeddedResource Include="Assets\sharepoint.png" LogicalName="sharepoint.png" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AnyFS.Sources.Tests" />
    <InternalsVisibleTo Include="SharePointSignIn" />
  </ItemGroup>
</Project>

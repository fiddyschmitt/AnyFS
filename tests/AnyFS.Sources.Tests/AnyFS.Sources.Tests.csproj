<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AnyFS.Sources.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AnyFS.Sdk\AnyFS.Sdk.csproj" />
    <ProjectReference Include="..\..\src\AnyFS.Sdk.Testing\AnyFS.Sdk.Testing.csproj" />
    <ProjectReference Include="..\..\src\Sources\Mirror\AnyFS.Sources.Mirror.csproj" />
    <ProjectReference Include="..\..\src\Sources\Sshfs\AnyFS.Sources.Sshfs.csproj" />
    <ProjectReference Include="..\..\src\Sources\Common\AnyFS.Sources.Common.csproj" />
    <ProjectReference Include="..\..\src\Sources\Microsoft365\AnyFS.Sources.Microsoft365.csproj" />
    <ProjectReference Include="..\..\src\Sources\SharePoint\AnyFS.Sources.SharePoint.csproj" />
    <ProjectReference Include="..\..\src\Sources\ThreeDX\AnyFS.Sources.ThreeDX.csproj" />
    <ProjectReference Include="..\..\src\Sources\Outlook\AnyFS.Sources.Outlook.csproj" />
    <ProjectReference Include="..\fixtures\MakeTree\MakeTree.csproj" />
    <ProjectReference Include="..\fixtures\SharePointSignIn\SharePointSignIn.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the Outlook source's tests read LibOutlook's PST fixtures (tests/LibOutlook.Tests/fixtures/README.md) -->
    <None Include="..\LibOutlook.Tests\fixtures\*.pst" Link="fixtures\outlook\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

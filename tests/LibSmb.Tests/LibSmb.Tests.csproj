<Project Sdk="Microsoft.NET.Sdk">
  <!-- LibSmb's tests: the handlers driven directly, as portable-smb-server's Go tests drive its own, and the server over a
       real TCP connection with the small SMB2 client here (SmbTestClient). The clients of Windows, macOS and Linux are
       tests/LibSmb.E2E's. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>LibSmb.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LibSmb\LibSmb.csproj" />
  </ItemGroup>
</Project>
